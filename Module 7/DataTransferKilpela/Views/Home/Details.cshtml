@model Country

@{
    ViewData["Title"] = "Country Details";
}

<h2 class="text-center p-2">Country Details</h2>

<div class="row">
    <div class="col">
        <ul class="list-group text-center">
            <li class="list-group-item">
                <img src="~/images/@Model.FlagImage" alt="" width="100" height="100" />
                <h3>@Model.Name</h3>
            </li>
            <li class="list-group-item">
                <h4>Game: @Model.Game.Name</h4>
            </li>
            <li class="list-group-item">
                <h4>Sport: @Model.Sport.Name</h4>
            </li>
            <li class="list-group-item">
                <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Return to Home Page</a>
                <form asp-action="AddToFavorites" asp-controller="Home" method="post" style="display: inline;">
                    <input type="hidden" name="id" value="@Model.CountryId" />
                    <button type="submit" class="btn btn-primary">Add to Favorites</button>
                </form>
            </li>
        </ul>
    </div>
</div>
