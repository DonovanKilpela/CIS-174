@using DataTransferKilpela.ViewModels
@model CountryFilterViewModel

<div class="container-fluid">
    <!-- Favorites Button -->
    <div class="bg-light p-3 mb-4">
        <a asp-action="Index" asp-controller="Favorites" class="btn btn-outline-primary w-100">
            Favorites (@ViewBag.FavoritesCount)
        </a>
    </div>
    <div class="row">
        <div class="col-md-3">
            <form asp-action="Index" method="get">
                <input type="hidden" name="SelectedCategory" value="@Model.SelectedCategory" />
                <h3>Filter by Game</h3>
                <div class="d-grid gap-2">
                    <button type="submit" name="SelectedGame" value="all"
                            class="btn @(Model.SelectedGame == "all" ? "btn-primary" : "btn-outline-primary")">
                        All
                    </button>
                    @foreach (var game in Model.Games)
                    {
                        <button type="submit" name="SelectedGame" value="@game.GameId"
                                class="btn @(Model.SelectedGame == game.GameId ? "btn-primary" : "btn-outline-primary")">
                            @game.Name
                        </button>
                    }
                </div>

                <input type="hidden" name="SelectedGame" value="@Model.SelectedGame" />
                <h3 class="mt-4">Filter by Category</h3>
                <div class="d-grid gap-2">
                    <button type="submit" name="SelectedCategory" value="all"
                            class="btn @(Model.SelectedCategory == "all" ? "btn-primary" : "btn-outline-primary")">
                        All
                    </button>
                    @foreach (var category in Model.Categories)
                    {
                        <button type="submit" name="SelectedCategory" value="@category"
                                class="btn @(Model.SelectedCategory == category ? "btn-primary" : "btn-outline-primary")">
                            @category
                        </button>
                    }
                </div>
            </form>
        </div>


        <div class="col-md-9">
            <h2>Countries</h2>

            <!-- Countries Section -->
            <div class="row">
                @foreach (var country in Model.Countries)
                {
                    <div class="col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                        <div class="country-item">
                            <a asp-action="Details" asp-route-id="@country.CountryId" class="country-link">
                                <img src="~/images/@country.FlagImage" alt="@country.Name" class="img-fluid"
                                     data-bs-toggle="tooltip"
                                     data-bs-placement="top"
                                     title="@country.Name - @country.Game.Name - @country.Sport.Category" />
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
