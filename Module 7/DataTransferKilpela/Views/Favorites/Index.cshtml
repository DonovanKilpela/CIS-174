@model List<Country>

@{
    ViewData["Title"] = "Favorites";
}

<h2 class="text-center p-2">Favorites</h2>

@if (Model.Count == 0)
{
    <p class="text-center">You haven't added any favorites yet.</p>
}
else
{
    <div class="row">
        @foreach (var country in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <img src="~/images/@country.FlagImage" class="card-img-top" alt="@country.Name">
                    <div class="card-body">
                        <h5 class="card-title">@country.Name</h5>
                        <p class="card-text">Game: @country.Game.Name</p>
                        <p class="card-text">Sport: @country.Sport.Name</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="text-center mt-3">
    <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Return to Home Page</a>
    <form asp-action="Clear" method="post" style="display: inline;">
        <button type="submit" class="btn btn-danger">Clear Favorites</button>
    </form>
</div>
